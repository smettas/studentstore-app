# Copy to backend/.env for local backend development. Never commit real secrets.
DJANGO_SECRET_KEY=replace-this-with-a-long-random-local-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_SETTINGS_MODULE=config.settings.local

# PostgreSQL
POSTGRES_DB=studentstore
POSTGRES_USER=studentstore_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Mobile API base URL (Android emulator usually uses 10.0.2.2 instead of localhost)
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api
