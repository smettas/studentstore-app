# Copy to backend/.env. NEVER commit actual secrets.
DJANGO_SECRET_KEY=replace-with-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_SETTINGS_MODULE=config.settings.local
POSTGRES_DB=studentstore
POSTGRES_USER=studentstore_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Console logs OTP only in DEBUG local development; use msg91 in production.
OTP_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api
STUDENTSTORE_DELIVERY_FEE=40.00
STUDENTSTORE_FREE_DELIVERY_THRESHOLD=999.00

# Razorpay: obtain TEST keys first; never put secrets in the Expo app.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Phase 12: keep local until R2 bucket, API token and public hostname are ready.
STUDENTSTORE_MEDIA_PROVIDER=local
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ENDPOINT_URL=
# Public custom domain for product images, e.g. images.example.com (no https://)
R2_PUBLIC_DOMAIN=
# Student Store Batch-02: private bucket with Django/Railway image delivery.
# Never reuse your academy R2 bucket credentials.
R2_DELIVERY_MODE=proxy
# When ready: R2_BUCKET_NAME=ojasone-studentstore
