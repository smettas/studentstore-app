# Documentation only: do NOT commit production secrets.
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=SET_A_UNIQUE_RANDOM_50_PLUS_CHARACTER_SECRET
DJANGO_ALLOWED_HOSTS=your-service.up.railway.app,api.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-service.up.railway.app,https://api.example.com
DJANGO_HSTS_SECONDS=0
# Railway: set DATABASE_URL to a variable reference such as ${{Postgres.DATABASE_URL}}
# For Windows import only: set DATABASE_URL to the Student Store PostgreSQL PUBLIC TCP proxy URL
# in a PRIVATE .env.batch02_railway file, selected with STUDENTSTORE_ENV_FILE.
DATABASE_URL=
# Optional browser-based admin/staff frontends; leave empty if none
CORS_ALLOWED_ORIGINS=
# Product images: R2 required in production
STUDENTSTORE_MEDIA_PROVIDER=r2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_ENDPOINT_URL=
# Set other integration secrets (Razorpay, OTP) only when those features go live.
# New, isolated Student Store bucket only. No Academy bucket credentials.
R2_BUCKET_NAME=ojasone-studentstore
# R2_DELIVERY_MODE=proxy: PRIVATE bucket, Railway Django streams images.
# This works without buying a domain but incurs Railway bandwidth/CPU.
R2_DELIVERY_MODE=proxy
# Optional ONLY when switching to a verified production custom image domain:
# R2_DELIVERY_MODE=public
# R2_PUBLIC_DOMAIN=images.your-owned-domain.example
